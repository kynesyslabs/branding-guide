{
  "$meta": {
    "name": "Demos Network Brand Tokens",
    "mode": "dark",
    "sources": [
      "https://demos.network/"
    ],
    "captureDate": "2026-09-28",
    "palettePolicy": "Black, white, neutrals and purple only, including statuses.",
    "provenance": "../PROVENANCE.md"
  },
  "color": {
    "brand": {
      "violet": "#7c3aed",
      "violet-hover": "#8b5cf6",
      "violet-strong": "#a78bfa",
      "violet-soft": "#7c3aed1f",
      "violet-soft-hover": "#7c3aed2e",
      "violet-border": "#7c3aed4d"
    },
    "bg": {
      "letterbox": "#06060a",
      "primary": "#0a0a0f",
      "base": "#0a0a0f",
      "secondary": "#111118",
      "subtle": "#111118",
      "card": "#16161f",
      "card-hover": "#1c1c28",
      "hover": "#1c1c28",
      "tinted": "#13121f"
    },
    "glass": {
      "card": "#16161ff2",
      "card-hover": "#1c1c28f2",
      "panel": "#0a0a0fd9",
      "border": "#ffffff14"
    },
    "text": {
      "primary": "#f0f0f5",
      "secondary": "#9ca3af",
      "muted": "#6b7280",
      "faint": "#9ca3af",
      "inverse": "#0a0a0a",
      "on-accent": "#ffffff"
    },
    "border": {
      "subtle": "#ffffff0e",
      "default": "#ffffff14",
      "strong": "#ffffff3d",
      "hover": "#ffffff29"
    },
    "status": {
      "success": "#a78bfa",
      "success-soft": "#7c3aed1f",
      "success-muted": "#a78bfa21",
      "warning": "#f0f0f5",
      "warning-soft": "#ffffff0f",
      "warning-muted": "#ffffff14",
      "error": "#a78bfa",
      "error-soft": "#7c3aed1f",
      "error-muted": "#a78bfa21",
      "info": "#9ca3af",
      "info-soft": "#ffffff0f",
      "info-muted": "#ffffff14"
    },
    "focus-ring": "#a78bfa"
  },
  "focusRing": "0 0 0 2px var(--color-bg-primary), 0 0 0 4px var(--color-focus-ring)",
  "gradient": {
    "brand": "linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%)",
    "glow-hero": "radial-gradient(60% 50% at 50% 35%, #7c3aed1a 0%, #7c3aed00 65%)",
    "glow-ambient": "radial-gradient(520px at 50% 30%, #7c3aed1a, #7c3aed08 35%, #00000000 60%)",
    "vignette": "radial-gradient(75% 55%, #00000000 0%, #000000b3 100%)"
  },
  "font": {
    "sans": "\"Plus Jakarta Sans\", system-ui, sans-serif",
    "display": "\"Plus Jakarta Sans\", system-ui, sans-serif",
    "mono": "\"Source Code Pro\", ui-monospace, monospace",
    "weight": {
      "normal": 400,
      "medium": 500,
      "semibold": 600,
      "bold": 700
    }
  },
  "fontSize": {
    "caption": "0.75rem",
    "label": "0.875rem",
    "base": "1rem",
    "lg": "1.125rem",
    "xl": "1.25rem",
    "2xl": "1.5rem",
    "3xl": "1.875rem",
    "hero": "3rem",
    "fluid-hero": "clamp(2.5rem, 7vw, 4.5rem)",
    "fluid-h2": "clamp(2.25rem, 5.5vw, 4.5rem)",
    "fluid-h3": "clamp(1.5rem, 3vw, 2rem)",
    "fluid-body": "clamp(1rem, 1.4vw, 1.125rem)"
  },
  "lineHeight": {
    "hero": 1.05,
    "tight": 1.1,
    "snug": 1.375,
    "normal": 1.5,
    "body": 1.6
  },
  "letterSpacing": {
    "tight": "-0.025em",
    "hero": "-0.02em",
    "section": "-0.015em",
    "wide": "0.025em",
    "eyebrow": "0.14em"
  },
  "space": {
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "5": "20px",
    "6": "24px",
    "8": "32px",
    "10": "40px",
    "12": "48px",
    "16": "64px",
    "20": "80px",
    "24": "96px",
    "32": "128px",
    "card-padding": "24px"
  },
  "layout": {
    "content": "1200px",
    "gutter": "24px",
    "section": "clamp(80px, 8vw, 128px)"
  },
  "radius": {
    "sm": "4px",
    "md": "6px",
    "chip": "6px",
    "lg": "8px",
    "button": "10px",
    "xl": "12px",
    "card": "14px",
    "2xl": "16px",
    "pill": "9999px"
  },
  "shadow": {
    "sm": "0 1px 2px #0006",
    "md": "0 0 0 1px #ffffff0e, 0 2px 6px #0006",
    "lg": "0 0 0 1px #ffffff0e, 0 8px 24px #00000080"
  },
  "blur": {
    "sm": "8px",
    "md": "12px",
    "2xl": "40px"
  },
  "motion": {
    "ease-standard": "cubic-bezier(0.4, 0, 0.2, 1)",
    "duration-fast": "150ms",
    "duration-base": "250ms",
    "transition": "all var(--duration-base) var(--ease-standard)"
  }
}
